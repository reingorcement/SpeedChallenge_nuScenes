# Edit the data location before running server.sh.
# Values supplied by the calling shell take priority.
export NUSCENES_ROOT="${NUSCENES_ROOT:-/data/nuscenes}"
export V3_FLOW_ROOT="${V3_FLOW_ROOT:-${NUSCENES_ROOT}/precomputed_flow_v2/CAM_FRONT}"
export V3_FRAME_ROOT="${V3_FRAME_ROOT:-${NUSCENES_ROOT}/precomputed_frames/CAM_FRONT_72x128_rgb}"
export PYTHON_BIN="${PYTHON_BIN:-python}"
export V3_DIRECT_BATCH_SIZE="${V3_DIRECT_BATCH_SIZE:-16}"
export V3_FUSION_BATCH_SIZE="${V3_FUSION_BATCH_SIZE:-4}"
export V3_NUM_WORKERS="${V3_NUM_WORKERS:-4}"
export V3_SEEDS="${V3_SEEDS:-42 3407 2026}"
export V3_TEST_BATCH_SIZE="${V3_TEST_BATCH_SIZE:-4}"
export V3_TEST_NUM_WORKERS="${V3_TEST_NUM_WORKERS:-0}"
export V3_CHECKPOINT="${V3_CHECKPOINT:-checkpoints/pretrained/fusion_seed_42/best.pth}"
